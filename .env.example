# ---- Shared ----
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://codesync:codesync@localhost:5432/codesync
REDIS_URL=redis://localhost:6379

# ---- API server ----
PORT=4000
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Origin of the frontend (used for CORS). In dev, Vite proxies /api so this is only needed for split deployments.
WEB_ORIGIN=http://localhost:5173
# Set to true when serving over HTTPS (production).
COOKIE_SECURE=false
RUN_RATE_LIMIT_PER_MIN=10
AUTH_RATE_LIMIT_PER_MIN=5
MAX_QUEUE_LENGTH=500

# ---- Worker ----
WORKER_CONCURRENCY=2
# Leave empty to use the default Docker socket.
DOCKER_SOCKET_PATH=
SANDBOX_IMAGE_PREFIX=codesync-sandbox
