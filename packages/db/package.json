{
  "name": "@codesync/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "postinstall": "prisma generate",
    "migrate:dev": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate dev",
    "migrate:deploy": "node --env-file=../../.env ./node_modules/prisma/build/index.js migrate deploy",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
